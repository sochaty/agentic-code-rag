# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Where corpora, indexes and traces live (relative to repo root).
ACR_DATA_DIR=data

# Models per role. Cheap roles: router, grader, rewriter. Heavy roles: planner, synthesizer, verifier.
ACR_MODEL_CHEAP=claude-haiku-5-5
ACR_MODEL_HEAVY=claude-sonnet-5-5

# Default per-question budget.
ACR_BUDGET_MAX_TOKENS=60000
ACR_BUDGET_MAX_SECONDS=60
