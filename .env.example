# Copy to .env and fill in. Never commit .env.

# Which model provider to use: openai (default) or anthropic.
ACR_PROVIDER=openai

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Any Chat Completions server works through the openai provider, e.g. local Ollama:
# ACR_OPENAI_BASE_URL=http://localhost:11434/v1
# ACR_MODEL_CHEAP=llama3.2
# ACR_MODEL_HEAVY=qwen2.5-coder:14b

# Models per role. Leave unset for the provider defaults:
#   openai:    gpt-6-luna (cheap)        / gpt-6.1-sol (heavy)
#   anthropic: claude-haiku-5-5 (cheap)  / claude-sonnet-5-5 (heavy)
# Cheap roles: router, grader, rewriter. Heavy roles: planner, synthesizer, verifier.
# ACR_MODEL_CHEAP=
# ACR_MODEL_HEAVY=

# Where corpora, indexes and traces live (relative to repo root).
ACR_DATA_DIR=data

# Default per-question budget.
ACR_BUDGET_MAX_TOKENS=60000
ACR_BUDGET_MAX_SECONDS=60
